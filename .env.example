# ==============================================================================
# TEMPLATE: Copy this to .env or .env.local and fill in your MongoDB credentials
# ==============================================================================

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/multi_agent_db)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/multi_agent_db?retryWrites=true&w=majority"
MONGODB_DB_NAME="multi_agent_db"
USE_REAL_MONGODB="false"

# Application Settings
NEXT_PUBLIC_APP_NAME="AuraAgent"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Multi-Agent Flags
NEXT_PUBLIC_ENABLE_AGENT_VERA="true"
NEXT_PUBLIC_ENABLE_AGENT_ATLAS="true"
NEXT_PUBLIC_ENABLE_AGENT_NOVA="true"

# Security
JWT_SECRET="aura_agent_super_secret_jwt_key_928374982374"
